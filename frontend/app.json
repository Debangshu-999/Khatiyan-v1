{
  "expo": {
    "name": "Khatiyan",
    "slug": "khatiyan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/logo-light.png",
    "scheme": "khatiyan",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/brand/logo-light.png",
        "dark": "./assets/brand/logo-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEFEFE",
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.khatiyan.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "isAccessMediaLocationEnabled": false,
          "savePhotosPermission": "Allow Khatiyan to save pictures from your chats to your gallery."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      "./plugins/with-upi-intent-launcher",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEFEFE",
          "image": "./assets/brand/logo-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0E14",
            "image": "./assets/brand/logo-dark.png"
          }
        }
      ],
      "./plugins/with-mappls-sdk",
      "expo-web-browser"
    ]
  }
}
