# Khatiyan environment template
# Copy this file to .env and replace every replace-me value. Never commit .env.

# Runtime
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/khatiyan_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password

# Valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=replace-with-your-local-valkey-password
VALKEY_DATABASE=0

# Authentication
JWT_SECRET=replace-with-a-new-long-random-secret
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60

# SMTP and email OTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
OTP_EMAIL_PROVIDER=smtp
OTP_EMAIL_FROM=no-reply@example.com
OTP_EMAIL_SUBJECT_PREFIX=Khatiyan

# Optional SMS provider
OTP_SMS_PROVIDER=log
OTP_SMS_URL=
OTP_SMS_AUTH_HEADER=authkey
OTP_SMS_AUTH_VALUE=replace-when-sms-is-enabled
OTP_SMS_SENDER_ID=
OTP_SMS_TEMPLATE_ID=
OTP_SMS_OTP_VARIABLE_NAME=OTP

# Optional WhatsApp provider
OTP_WHATSAPP_PROVIDER=log
OTP_WHATSAPP_URL=
OTP_WHATSAPP_AUTH_HEADER=Authorization
OTP_WHATSAPP_AUTH_VALUE=replace-when-whatsapp-is-enabled
OTP_WHATSAPP_SENDER_ID=
OTP_WHATSAPP_TEMPLATE_ID=

# Optional Firebase and Razorpay integration
FIREBASE_AUTH_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
RAZORPAY_KEY_ID=replace-when-razorpay-is-enabled
RAZORPAY_KEY_SECRET=replace-when-razorpay-is-enabled
RAZORPAY_WEBHOOK_SECRET=replace-when-webhooks-are-enabled
