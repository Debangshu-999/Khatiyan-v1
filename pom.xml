<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.khatiyan</groupId>
    <artifactId>khatiyan</artifactId>
    <version>0.1.0</version>
    <name>khatiyan</name>
    <description>PG and hostel management — the digital khatiyan</description>

    <properties>
        <java.version>21</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.38</lombok.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <bucket4j.version>8.11.1</bucket4j.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <springdoc.version>3.1.1</springdoc.version>
        <shedlock.version>7.10.1</shedlock.version>
        <!-- Pinned ahead of what Boot 3.3.5 manages. Docker Engine 29 refuses API
             versions below 1.40, and the docker-java inside Testcontainers 1.20.x
             negotiates lower than that — every container start failed with a bare
             "Could not find a valid Docker environment", which is HTTP 400 from a
             pipe that was reachable all along. Do not drop this below 1.21. -->
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- Spring AI 2.0.1 builds against Boot 4.1.1 exactly, which is why the
             Boot 4 upgrade was Milestone 0 of the intelligence work. -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- Test groups the normal build skips. "spike" tests make real calls to
             a paid-or-rate-limited provider, so they must be asked for by name:
                 mvn test -Dtest=GroqProviderSpikeTest -Dtest.excluded.groups=
             Overridable rather than hard-coded so the exclusion can be lifted
             without editing this file. -->
        <test.excluded.groups>spike</test.excluded.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- OkHttp, forced to 4.x.

                 razorpay-java 1.4.8 pins okhttp 3.10.0 and, being nearer in the
                 tree, it won. Spring AI's OpenAI client is built on okhttp 4,
                 so the first provider call died on
                 NoSuchMethodError: OkHttpClient$Builder.pingInterval(Duration)
                 — a 4.x method absent from 3.10.

                 Safe to force here: payments are parked and the Razorpay client
                 is inert (see the payments note in the project memory), and
                 okhttp 4 is binary-compatible with 3 for the calls it makes.
                 Revisit if payments are ever switched back on. -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>4.12.0</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <!-- Event publication registry: records each domain event in the same
             transaction that publishes it and re-submits incomplete publications
             after a crash/restart. JDBC (not JPA) variant so Hibernate
             ddl-auto:validate never inspects it; the table is owned by Flyway
             (V6040). Jackson artifact provides the event (de)serializer. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-jackson</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring AI, for the intelligence module.

             The OpenAI starter, because both providers speak the OpenAI wire
             format: Groq at api.groq.com/openai/v1 and Cloudflare Workers AI at
             their /ai/v1 endpoint. Nothing here talks to OpenAI itself.

             Its auto-configuration is excluded on purpose. It would build a
             ChatModel from spring.ai.openai.* pointing at api.openai.com, and
             this module builds both models explicitly with their own base URL,
             key and retry policy (AI spec §8.3). An auto-configured model left
             lying around is one an autowire could pick by accident. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- RestClient's auto-configuration, another Boot 4 split.

             The geocoding providers inject RestClient.Builder. On Boot 3 the web
             starter carried that auto-configuration; on Boot 4 it lives here, so
             without it the builder has no bean and every geo bean fails to
             construct. Same shape as spring-boot-flyway below. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>

        <!-- Jackson 2, kept deliberately alongside Boot 4's Jackson 3.

             Boot 4 defaults to Jackson 3 (tools.jackson) and no longer
             auto-configures a com.fasterxml.jackson ObjectMapper, so the nine
             classes that inject one lost their bean. This module puts it back.

             Not a temporary shim to remove later: the agreement content hash
             MUST stay on Jackson 2 (§6.2 hazard 1 of the AI spec, and
             AgreementContentHashTest). Every already-signed deed is bound to
             the bytes Jackson 2 produces, so Jackson 2 is on this classpath for
             good and the compatibility module is the supported way to have it.
             Boot's own BOM manages both lines: jackson-bom 3.x and
             jackson-2-bom 2.x. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- Flyway's Boot integration, which is a SEPARATE artifact on Boot 4.

             Boot 3 shipped every auto-configuration in one jar, so flyway-core
             alone was enough. Boot 4 splits them per technology and this project
             has no Flyway starter to pull the new one in, so without this line
             Flyway is on the classpath and simply never runs: no schemas, no
             tables, and — with ddl-auto anything other than validate — an
             application that starts happily against an unmigrated database.

             It failed here as "missing table [auth.login_attempts]", which is
             not a Flyway message at all. That is just the first table Hibernate
             happened to look for. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
          <dependency>
              <groupId>com.google.firebase</groupId>
              <artifactId>firebase-admin</artifactId>
              <version>9.8.0</version>
          </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Resilience4j (for circuit breakers and retries on external calls) -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- Payments -->
        <dependency>
            <groupId>com.razorpay</groupId>
            <artifactId>razorpay-java</artifactId>
            <version>1.4.8</version>
        </dependency>

        <!-- Rate limiting -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-redis-common</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-lettuce</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- DTO mapping -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- API documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- AOP, required by the Resilience4j annotations.

             Boot 4 removed spring-boot-starter-aop: the auto-configuration moved
             into spring-boot-autoconfigure, and all the starter added on top of
             it was AspectJ, which the BOM manages directly. This is that half. -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- ShedLock: distributed locks so each scheduled job runs on only one
             instance at a time, preventing duplicate jobs across the fleet. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The context-loading harness. Nothing in this project has ever
             started the real application context in a test, so a bean cycle, a
             missing migration or a broken JPA mapping only ever showed up on a
             developer's own boot. See docs/testing/context-harness.md. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Renders the tenancy bill receipt to PDF server-side.

            The document used to be built as an HTML string in the app and handed
            to expo-print, whose web implementation is a bare window.print() that
            ignores the markup entirely — so a browser printed the billing screen
            instead of the bill, and no file was produced at all. Generating here
            means one document, byte-identical for the owner and the tenant, and
            an ordinary file download on every platform.
        -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.0.10</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                    <systemPropertyVariables>
                        <!-- Docker Engine 29 refuses API versions below 1.40, and the
                             docker-java inside Testcontainers negotiates lower unless it
                             is told not to. Without this every container start fails as
                             "Could not find a valid Docker environment", which reads as a
                             missing Docker rather than as the HTTP 400 it actually is.

                             1.44 is Docker 25 and above, so it is safe anywhere the
                             harness could plausibly run. Raise it, never lower it. -->
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
